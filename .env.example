# Generate a local key with: uv run python scripts/bootstrap.py
MASTER_API_KEY=replace-with-a-long-random-secret
DATABASE_PATH=data/master-agent.sqlite3
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_NUM_CTX=16384
OLLAMA_NUM_PREDICT=6000
PLANNER_MAX_ATTEMPTS=3
N8N_BASE_URL=http://127.0.0.1:5678
N8N_API_KEY=
N8N_OLLAMA_BASE_URL=http://127.0.0.1:11434
HTTP_ALLOWED_HOSTS=[]
WORKFLOW_TIMEZONE=Asia/Tehran
N8N_IMAGE=docker.n8n.io/n8nio/n8n:2.48.5
# Native host tools; defaults to the directory from which Master is started.
# LOCAL_WORKSPACE=/absolute/path/to/your/project
# Keep vault.key alongside the SQLite database and include both in private backups.
# LOCAL_VAULT_KEY=data/vault.key
LOCAL_MAX_STEPS=10
CODING_MAX_STEPS=20
LOCAL_PLUGIN_MODULES=[]
